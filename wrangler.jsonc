{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cgl-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
